# Copy this file to .env.local (which is gitignored) for local development,
# and set the same two values as Environment Variables in your Vercel project
# (Project Settings → Environment Variables) for production.
#
# Both values come from your Supabase project: Project Settings → API.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
